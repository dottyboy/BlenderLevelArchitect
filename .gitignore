# Python bytecode
__pycache__/
*.pyc

# Blender auto-backup files -- never meaningful to track
*.blend1
*.blend2

# Ad hoc manual test/scratch .blend files kept at the repo root
/*.blend

# Build output -- regenerate with ./build_package.sh
/dist/game_level_architect/
/dist/game_level_architect.zip

# Generated test .blend files -- regenerate with ./generate_test_blends.sh
# and tests/generate_cave_gallery.py
/test_blends/

# Full internal dev log -- local-only, uncondensed counterpart to the
# tracked, pushed DEVELOPMENT.md (see that file's own note on the split)
/DEVELOPMENT_OFFLINE.md

# Claude Code local settings -- used to track /.claude/settings.json as a
# shared, project-level permission allowlist, but that allowlist gets added
# to automatically (including exact commands with local machine paths baked
# in, e.g. a specific Blender install path under this machine's home
# directory) and got pushed to the public repo once already. Not worth the
# leak risk for what it saves; the whole folder is local-only now.
/.claude/

# OS cruft
.DS_Store
Thumbs.db
